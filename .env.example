# ─────────────────────────────────────────────────────────────────────────────
#  Panel de Métricas — plantilla de credenciales
#
#  NO edites este archivo. El instalador crea el `.env` de verdad y lo llena
#  solo. Esto está acá para documentar qué variable hace qué, y para el caso de
#  que prefieras cargarlas a mano.
#
#  Si lo hacés a mano: copiá este archivo como `.env` y completá los valores.
#  El `.env` nunca se sube a GitHub (está en el .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ── OBLIGATORIO: Instagram y Facebook ────────────────────────────────────────
# Sin estos dos el panel no tiene nada que mostrar. Los consigue el instalador
# solo: crea el token de dos horas del Explorador de Meta y lo convierte en uno
# permanente. Hacerlo a mano es posible pero es el paso donde se traba todo el
# mundo, así que conviene dejárselo al instalador.

IG_PAGE_TOKEN=
IG_USER_ID=

# El ID de la Página de Facebook vinculada a esa cuenta de Instagram. Sin esto la
# pantalla de Facebook queda vacía. El instalador lo saca del token, no lo pregunta.
FB_PAGE_ID=

# El App ID de la app de Meta: también sale del token. El App Secret sólo hace falta
# si el token que pegaste vence, para poder canjearlo por uno permanente; con un token
# de Página que no vence no se usa.
IG_APP_ID=
IG_APP_SECRET=


# ── OPCIONAL: el análisis con IA ─────────────────────────────────────────────
# Hay dos caminos y solo hace falta uno:
#
#   1. Tener Claude Code instalado (npm i -g @anthropic-ai/claude-code).
#      El panel lo detecta y lo usa. No cuesta nada extra: corre sobre la
#      suscripción de Claude que ya pagás. Es el camino por defecto.
#
#   2. Una API key. Se paga por uso (~4 USD/mes con un análisis por día) y no
#      requiere instalar nada. Se saca en console.anthropic.com > API Keys.
#
# Sin ninguno de los dos, el panel funciona igual: los números, los gráficos y
# la competencia no necesitan IA. Se apagan el análisis escrito y el botón Generar.

ANTHROPIC_API_KEY=

# Cuál de los dos caminos usar:
#   auto   (por defecto) Claude Code si está instalado; si no, la API key
#   claude forzar Claude Code
#   api    forzar la API key
IA_MODO=auto

# El modelo. Por defecto claude-opus-5, que es el que mejor analiza. Se puede
# bajar a claude-sonnet-5 para gastar menos si usás API key.
ANTHROPIC_MODEL=

# Otro proveedor en vez de Anthropic. Solo sirve con los que hablan el MISMO
# formato de pedido (Kimi/Moonshot, DeepSeek). OpenAI no entra por acá: habla
# otro idioma. Los compatibles autentican con token en vez de API key, así que
# van juntos: dejá ANTHROPIC_API_KEY vacía y completá estas tres.
#   ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
#   ANTHROPIC_AUTH_TOKEN=<tu key de Moonshot>
#   ANTHROPIC_MODEL=kimi-k2.7-code
# Ojo: Moonshot no publica el contrato de ese endpoint, así que puede cambiar
# sin aviso. Con Anthropic, que sí lo publica, eso no pasa.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=


# ─── YOUTUBE (opcional) ──────────────────────────────────────────────────────
#
# YouTube no entra con un token pegado como Meta: Google pide autorizar desde el
# navegador. Es una vez y gratis:
#
#   1. console.cloud.google.com > crear un proyecto
#   2. Habilitar "YouTube Data API v3" y "YouTube Analytics API"
#   3. Credenciales > ID de cliente de OAuth > Aplicación de escritorio > descargar
#   4. Dejar ese JSON en la carpeta del panel como client_secret.json,
#      o pegar acá abajo las dos partes que trae adentro
#   5. python3 yt_token.py auth   y seguir lo que dice
#
# Si no lo configurás, el panel funciona igual: la pantalla de YouTube queda vacía.

YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Sólo si querés que los archivos vivan en otro lado que no sea esta carpeta:
#   YT_CLIENT_FILE=  el JSON descargado de Google Cloud (por defecto: client_secret.json)
#   YT_TOKEN_FILE=   dónde guardar el token ya autorizado (por defecto: youtube_token.json)


# ── OPCIONAL: Facebook Ads ───────────────────────────────────────────────────
# Solo si querés ver campañas pagas en el panel. Es una credencial DISTINTA de
# la de arriba: necesita el permiso ads_read.
META_ADS_TOKEN=

# Alternativa: en vez de copiar el token acá, apuntá al archivo donde ya vive.
# Así el secreto existe en un solo lugar y rotarlo se hace una sola vez.
# META_ADS_TOKEN_FILE=/ruta/al/.env.local
# META_ADS_TOKEN_KEY=META_ACCESS_TOKEN


# ── OPCIONAL: TikTok ─────────────────────────────────────────────────────────
# developers.tiktok.com > tu app > Credenciales. Pedí SOLO los permisos de lectura
# (user.info.basic, user.info.stats, video.list): los de publicar son los que TikTok
# rechaza, y pedirlos de más es lo que hace fallar la revisión.
# TIKTOK_REDIRECT es cualquier página tuya: solo recibe el código en la URL. NO uses
# una que canjee el código (como la de Postiz): un código es de un solo uso.
# Después: python3 tiktok.py auth  →  python3 tiktok.py code "<url>"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT=


# ── OPCIONAL: el puerto del panel ────────────────────────────────────────────
# Cambialo solo si el 8760 ya está ocupado por otra cosa.
# PUERTO=8760
